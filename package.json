{
  "name": "playloggg",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next typegen && tsc --noEmit && eslint . && node --experimental-strip-types --test scripts/test-*.mjs && node --experimental-strip-types scripts/bootstrap-catalog.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test scripts/test-*.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/post-deploy-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.0"
  }
}
