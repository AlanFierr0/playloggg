NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only owner configuration; put real values in ignored .env.local.
PLAYLOGG_OWNER_EMAIL=
PLAYLOGG_SITE_URL=http://localhost:3000
# Server-only IGDB catalog search/import. Never use NEXT_PUBLIC_ for these.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
SUPABASE_SECRET_KEY=
# Server-only Steam library access (separate from Steam OpenID sign-in).
STEAM_WEB_API_KEY=

# Optional server-only Gemini free-tier key for completion achievement classification.
GEMINI_API_KEY=
